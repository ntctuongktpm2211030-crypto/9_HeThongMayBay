{
    "tickets": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Tickets",
      "type": "object",
      "required": ["tickets"],
      "properties": {
        "tickets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "maVe",
              "maDatCho",
              "maHK",
              "hangGhe",
              "soGhe",
              "gia",
              "thanhTien",
              "trangThai"
            ],
            "properties": {
              "maVe": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "maDatCho": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "maHK": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "hangGhe": {
                "type": "string"
              },
              "soGhe": {
                "type": "string"
              },
              "gia": {
                "type": "number",
                "minimum": 0
              },
              "thanhTien": {
                "type": "number",
                "minimum": 0
              },
              "trangThai": {
                "type": "string",
                "enum": ["Paid", "Booked", "Cancelled"]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
}