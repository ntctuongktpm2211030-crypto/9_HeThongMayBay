{
  "$id": "https://example.com/TaiKhoan_schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DanhSachTaiKhoan",
  "type": "object",
  "properties": {
    "DanhSachTaiKhoan": { "$ref": "#/$defs/DanhSachTaiKhoan" }
  },
  "required": ["DanhSachTaiKhoan"],
  "additionalProperties": false,
  "$defs": {
    "DanhSachTaiKhoan": {
      "type": "object",
      "properties": {
        "TaiKhoan": {
          "type": "array",
          "items": { "$ref": "#/$defs/TaiKhoan" }
        }
      },
      "required": ["TaiKhoan"],
      "additionalProperties": false
    },
    "TaiKhoan": {
      "type": "object",
      "properties": {
        "MaTK": { "type": "integer", "minimum": 1 },
        "TenDangNhap": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_\\.\\-]{3,31}$"
        },
        "MatKhau": {
          "type": "string",
          "minLength": 6,
          "maxLength": 64
        },
        "MaHK": { "type": "integer", "minimum": 1 }
      },
      "required": ["MaTK", "TenDangNhap", "MatKhau", "MaHK"],
      "additionalProperties": false
    }
  }
}